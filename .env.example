# Copy this file to .env and fill in real values. Never commit .env.
# settings.py reads these via python-dotenv at startup.

# --- Core ---
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# 'True' enables debug mode. Anything else (including unset) means production.
DEBUG=True
# Comma-separated. Required when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
DB_NAME=paid_parking_system
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Administrator bootstrap ---
# Read by "python manage.py ensure_admin", which creates a superuser only when
# the project has none. The password must pass the normal validators.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# --- CORS ---
# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- JWT lifetimes ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
