# React / JavaScript Specifics
# ==========================================
# Dependency directories
node_modules/
jspm_packages/

# Production / build artifacts
build/
dist/
out/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript cache
*.tsbuildinfo

# ==========================================
